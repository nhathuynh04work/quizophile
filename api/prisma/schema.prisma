generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordDigest String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  quizzes        Quiz[]
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  status    QuizStatus @default(PRIVATE)
  content   Json?
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum QuizStatus {
  PRIVATE
  PUBLIC
  ARCHIVED
}
